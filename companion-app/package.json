{
  "name": "cheerdeck-desktop",
  "version": "1.3.0",
  "description": "CheerDeck Desktop — the full panel in a window, with gift-to-keystroke built in.",
  "author": "CheerDeck",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.cheerdeck.desktop",
    "productName": "CheerDeck",
    "files": [
      "main.js"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "SlimChances",
        "repo": "cheerdeck-desktop"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "CheerDeck-Setup.${ext}"
    }
  }
}
